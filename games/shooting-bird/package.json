{
  "name": "kids-game-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @kgf/site",
    "build": "npm run build --workspace @kgf/site",
    "preview": "npm run preview --workspace @kgf/site",
    "typecheck": "tsc -p packages/core && tsc -p games/duck-hunt && tsc -p apps/site"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
